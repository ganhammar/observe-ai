<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ObserveAi</RootNamespace>
    <AssemblyName>bootstrap</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- provided.al2023 on arm64, deployed as a zip: the published output must
         contain a native executable literally named "bootstrap". -->
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseRidGraph>false</UseRidGraph>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets tests drive FunctionHandlerAsync's body with a fake IBedrockInvoker
         instead of one built from real AWS configuration. -->
    <InternalsVisibleTo Include="ObserveAi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="2.2.2" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- tree.json is the single source of truth shared
         with the Python side. Embedding it keeps the deployment zip
         self-contained with no extra file to stage alongside the binary. -->
    <EmbeddedResource Include="tree.json">
      <Link>tree.json</Link>
      <LogicalName>ObserveAi.tree.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
